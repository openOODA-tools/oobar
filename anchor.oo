// # oobar Root Anchor Subsystem
//
// Logline: Top-level anchor re-exporting progress models, track compositing, and MCP stdio IPC.
//
// Setup: Root barrel shim linking all oobar subsystem anchors into a coherent suite.
//
// Beats:
//   1. Re-export core progress meter models, glyph palettes, and track compositors.
//   2. Re-export render formatting subsystem with ANSI colors and JSON visualizers.
//   3. Re-export Model Context Protocol (MCP) IPC subsystem and CLI argument parsers.
//   4. Expose unified system metadata and version verification constants.

import "core/anchor.oo";
import "render/anchor.oo";
import "ipc/anchor.oo";

pub fn oobar_version() -> String {
    return "0.2.0";
}

pub fn oobar_summary() -> String {
    return "Sovereign Terminal Progress Meter with ETA & Throughput Gauges";
}

// # JSON Field Parser and String Escaping
//
// Logline: Extracts JSON fields and encodes strings for Model Context Protocol frames.
//
// Setup: Pure string utilities for parsing and serializing JSON-RPC envelopes.
//
// Beats:
//   1. Extract unquoted field values from simple and nested JSON payloads.
//   2. Extract quoted string values without brace tracking distortion.
//   3. Escape arbitrary characters into valid JSON string representations.

fn skip_string(json: String, i: Int) -> Int {
    let n: Int = chars_len(json);
    let mut j: Int = i + 1;
    while j < n {
        let c: String = char_at(json, j);
        if c == "\\" {
            j = j + 2;
        } else if c == "\"" {
            return j + 1;
        } else {
            j = j + 1;
        }
    }
    return n;
}

fn scan_balanced(json: String, start: Int) -> Int {
    let n: Int = chars_len(json);
    let mut depth: Int = 0;
    let mut i: Int = start;
    while i < n {
        let c: String = char_at(json, i);
        if c == "\"" {
            i = skip_string(json, i);
        } else {
            if c == "{" || c == "[" { depth = depth + 1; }
            else if c == "}" || c == "]" {
                depth = depth - 1;
                if depth == 0 { return i + 1; }
            }
            i = i + 1;
        }
    }
    return n;
}

fn find_value_start(json: String, key: String) -> Int {
    let n: Int = chars_len(json);
    let mut depth: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(json, i);
        if c == "\"" {
            let after: Int = skip_string(json, i);
            if depth == 1 {
                let name: String = str_slice(json, i + 1, after - 1);
                if name == key {
                    let mut j: Int = after;
                    while j < n {
                        let c2: String = char_at(json, j);
                        if c2 == ":" {
                            j = j + 1;
                            while j < n {
                                let c3: String = char_at(json, j);
                                if c3 != " " && c3 != "\t" && c3 != "\r" && c3 != "\n" {
                                    return j;
                                }
                                j = j + 1;
                            }
                            return n;
                        }
                        j = j + 1;
                    }
                }
            }
            i = after;
        } else {
            if c == "{" || c == "[" { depth = depth + 1; }
            else if c == "}" || c == "]" { depth = depth - 1; }
            i = i + 1;
        }
    }
    return n;
}

pub fn json_get_field(json: String, key: String) -> String {
    let n: Int = chars_len(json);
    let v_start: Int = find_value_start(json, key);
    if v_start >= n { return ""; }
    let first: String = char_at(json, v_start);
    if first == "{" || first == "[" {
        let v_end: Int = scan_balanced(json, v_start);
        return str_slice(json, v_start, v_end);
    }
    if first == "\"" {
        let v_end: Int = skip_string(json, v_start);
        return str_slice(json, v_start, v_end);
    }
    let mut j: Int = v_start;
    while j < n {
        let c: String = char_at(json, j);
        if c == "," || c == "}" || c == "]" || c == " " || c == "\t" || c == "\r" || c == "\n" {
            return str_slice(json, v_start, j);
        }
        j = j + 1;
    }
    return str_slice(json, v_start, n);
}

pub fn json_get_string(json: String, key: String) -> String {
    let raw: String = json_get_field(json, key);
    let n: Int = chars_len(raw);
    if n >= 2 && str_starts_with(raw, "\"") && str_ends_with(raw, "\"") {
        return str_slice(raw, 1, n - 1);
    }
    return raw;
}

pub fn json_escape_string(s: String) -> String {
    let mut out: String = "";
    let n: Int = chars_len(s);
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "\\" {
            out = out + "\\\\";
        } else if c == "\"" {
            out = out + "\\\"";
        } else if c == "\n" {
            out = out + "\\n";
        } else if c == "\r" {
            out = out + "\\r";
        } else if c == "\t" {
            out = out + "\\t";
        } else {
            out = out + c;
        }
        i = i + 1;
    }
    return out;
}
